[gd_scene load_steps=5 format=3]

[ext_resource type="Theme" path="res://ui/theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://ui/components/quest_tracker.gd" id="2_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 14.0
content_margin_top = 8.0
content_margin_right = 16.0
content_margin_bottom = 8.0
bg_color = Color(0.1098, 0.149, 0.2196, 0.75)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 1, 1, 0.22)
corner_radius_top_left = 18
corner_radius_top_right = 18
corner_radius_bottom_right = 18
corner_radius_bottom_left = 18
shadow_color = Color(0.04, 0.07, 0.12, 0.45)
shadow_size = 6

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_badge"]
bg_color = Color(0.95, 0.72, 0.22, 0.95)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="QuestTracker" type="PanelContainer"]
theme = ExtResource("1_theme")
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")
script = ExtResource("2_script")

[node name="HBox" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="QuestBadge" type="PanelContainer" parent="HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 24)
layout_mode = 2
size_flags_vertical = 4
theme_override_styles/panel = SubResource("StyleBoxFlat_badge")

[node name="QuestBadgeLabel" type="Label" parent="HBox/QuestBadge"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.12, 0.1, 0.05, 1)
theme_override_font_sizes/font_size = 14
text = "!"
horizontal_alignment = 1
vertical_alignment = 1

[node name="QuestTitleLabel" type="Label" parent="HBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "야생화 채집"

[node name="Separator" type="Label" parent="HBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.4)
theme_override_font_sizes/font_size = 14
text = "•"

[node name="QuestProgressLabel" type="Label" parent="HBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.95, 1, 1)
theme_override_font_sizes/font_size = 14
text = "0 / 5"
