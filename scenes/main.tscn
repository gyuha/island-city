[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/world/island.tscn" id="2_island"]
[ext_resource type="PackedScene" path="res://scenes/characters/player.tscn" id="3_player"]
[ext_resource type="PackedScene" path="res://scenes/characters/camera_rig.tscn" id="4_cam"]
[ext_resource type="PackedScene" path="res://ui/hud.tscn" id="5_hud"]

[node name="Main" type="Node3D"]
script = ExtResource("1_main")

[node name="Island" parent="." instance=ExtResource("2_island")]

[node name="Player" parent="." instance=ExtResource("3_player")]

[node name="CameraRig" parent="." instance=ExtResource("4_cam")]
target_path = NodePath("../Player")

[node name="HUD" parent="." instance=ExtResource("5_hud")]
